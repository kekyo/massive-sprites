{
  "name": "massive-sprites",
  "version": "0.0.1",
  "description": "Plots and traces a lot of sprite images onto logical branch graph",
  "keywords": [
    "sprite",
    "image",
    "graph",
    "webgl"
  ],
  "author": "Kouji Matsui (@kekyo@mi.kekyo.net)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kekyo/massive-sprites"
  },
  "homepage": "https://github.com/kekyo/massive-sprites#readme",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./logical-graph": {
      "types": "./dist/logical-graph.d.ts",
      "import": "./dist/logical-graph.mjs",
      "require": "./dist/logical-graph.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/generate-layout.mjs && vite build",
    "dev": "npm run build",
    "dev2": "npm run build",
    "test": "npm run build && vitest run",
    "pack": "npm run build && screw-up pack --pack-destination ../artifacts/"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": ">=20.0.0",
    "emsdk-env": ">=0.10.0",
    "funcity-cli": ">=1.4.0",
    "jsdom": ">=28.1.0",
    "prettier-max": ">=1.14.0",
    "screw-up": ">=1.26.0",
    "typescript": ">=5.0.0",
    "vite": ">=5.0.0",
    "vite-plugin-dts": ">=4.5.0",
    "vitest": ">=1.0.0"
  }
}
